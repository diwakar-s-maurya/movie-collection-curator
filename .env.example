# TMDB v4 read access token: https://www.themoviedb.org/settings/api
# ("API Read Access Token", the long JWT — not the v3 API key.)
TMDB_ACCESS_TOKEN=

# Postgres. Both default to the databases docker-compose.yml creates.
DATABASE_URL=postgresql://postgres:password@localhost:5432/curator
# Only the service tests use this, and they truncate it between cases.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/curator_test

# API port. The web dev server reads this too, so its /api proxy follows.
PORT=3000
# How long a graceful shutdown may take before the process is forced down.
SHUTDOWN_TIMEOUT_MS=10000
