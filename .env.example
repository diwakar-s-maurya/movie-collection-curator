# TMDB v4 read access token: https://www.themoviedb.org/settings/api
# ("API Read Access Token", the long JWT — not the v3 API key.)
TMDB_ACCESS_TOKEN=
# Per-request deadline for TMDB calls. Past it, an error beats a spinner.
TMDB_TIMEOUT_MS=5000

# Postgres. Both default to the databases docker-compose.yml creates.
DATABASE_URL=postgresql://postgres:password@localhost:5432/curator
# Only the service tests use this, and they truncate it between cases.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/curator_test

# Connection pool, per API process. Postgres' limit is this times the number of
# processes, so shrink it before running a second one.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
# How long a query waits for a free connection before it gives up.
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
# How long a query may run once it has one. Postgres cancels it past this, so
# a query blocked on a lock cannot hold a pooled connection indefinitely.
DATABASE_STATEMENT_TIMEOUT_MS=5000
# TLS to Postgres. The compose database serves no certificate; a managed one
# needs this true.
DATABASE_SSL=false

# API port. The web dev server reads this too, so its /api proxy follows.
PORT=3000
# How long a client may take to deliver a request, headers included.
SERVER_REQUEST_TIMEOUT_MS=30000
# How long a graceful shutdown may take before the process is forced down.
SHUTDOWN_TIMEOUT_MS=10000

# `Secure` on the session cookie: false on http://localhost, which would
# otherwise refuse to store it. The deployment sets it true in fly.toml.
COOKIE_SECURE=false
